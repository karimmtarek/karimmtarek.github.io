#!/usr/bin/env bash
# Smoke checks on the production build. Run after `BRIDGETOWN_ENV=production bin/bridgetown deploy`.
set -euo pipefail
o=output
fail() { echo "FAIL: $1"; exit 1; }

[ -f "$o/index.html" ] || fail "no index.html"
[ "$(grep -c '<h1' "$o/index.html")" = "1" ] || fail "homepage must have exactly one h1"
for p in about posts updates 500.html; do [ ! -e "$o/$p" ] || fail "starter path $p still built"; done
grep -rqi 'welcome to your new bridgetown\|Your First Post' "$o" --include='*.html' && fail "starter text in output" || true
grep -q 'name="robots" content="noindex"' "$o/404.html" || fail "404 lacks noindex"
grep -q 'id="projects"' "$o/404.html" && fail "404 still renders the homepage" || true
grep -q 'rel="canonical"' "$o/404.html" && fail "404 carries a canonical" || true
grep -q 'href="#"' "$o/index.html" && fail 'dead href="#" on homepage' || true
grep -q 'href="mailto:' "$o/index.html" || fail "no mailto in served HTML"
grep -qi 'built at PIVOT' "$o/index.html" && fail "claim wording: built at PIVOT" || true
grep -qi 'more_brands\|technical_stack' "$o/index.html" && fail "unrendered YAML section leaked into output" || true
[ -f "$o/robots.txt" ] || fail "no robots.txt"
[ "$(head -c 5 "$o/sitemap.xml")" = "<?xml" ] || fail "sitemap.xml missing or has leading whitespace"
grep -rq 'Bridgetown is loaded' "$o/_bridgetown/static" && fail "console.info still bundled" || true
for id in work projects own-work about contact; do
  grep -q "id=\"$id\"" "$o/index.html" || fail "homepage lacks #$id"
done
grep -q 'href="#services"' "$o/index.html" && fail "removed services nav link still present" || true
grep -q 'Get in touch' "$o/index.html" || fail "header contact button missing"
grep -qi 'commits' "$o/index.html" && fail "commit counts remain in rendered copy" || true
grep -qi 'FDA-cleared\|more complex PDP\|agency layers\|Salesforce' "$o/index.html" && fail "unsupported project or offer wording remains" || true
grep -q 'Product Configurator' "$o/index.html" && fail "unsupported Product Configurator tag remains" || true
grep -q 'Selected Shopify Plus work at PIVOT' "$o/index.html" || fail "project heading missing"
grep -q 'Recommendations from clients and colleagues' "$o/index.html" || fail "testimonial heading missing"
[ "$(grep -o '<dd[^>]*>[^<]*' "$o/index.html" | wc -l | tr -d ' ')" = "3" ] || fail "proof strip must contain three items"
[ -s "$o/images/karim-portrait-192.jpg" ] || fail "mobile portrait missing"
grep -q '<title>Karim Tarek: Senior Shopify Developer in Victoria, BC</title>' "$o/index.html" || fail "identity title missing"
grep -q '<h1[^>]*>Karim Tarek, senior Shopify developer</h1>' "$o/index.html" || fail "identity h1 missing"
grep -qi 'fullstack\|fighting you\|last 9\|Vuori' "$o/index.html" && fail "superseded identity copy remains" || true
grep -q 'About Karim Tarek' "$o/index.html" || fail "About identity heading missing"
grep -q 'Pacific time' "$o/index.html" || fail "approved location line missing"
[ "$(grep -o 'goodharbour.ca' "$o/index.html" | wc -l | tr -d ' ')" -ge "3" ] || fail "Goodharbour handoff links missing"
grep -q 'contact/?type=commerce' "$o/index.html" || fail "Shopify handoff missing"
grep -q 'contact/?type=team' "$o/index.html" || fail "team handoff missing"
grep -o '<a[^>]*goodharbour.ca[^>]*>' "$o/index.html" | grep -q 'noreferrer\|target=\|utm_' && fail "Goodharbour handoff hides referral" || true
grep -qi 'retainer\|agency layers\|available for' "$o/index.html" && fail "competing offer wording remains" || true
grep -q 'id="working-together"' "$o/index.html" && fail "K1-A must not render an offer section" || true
grep -q 'These buttons open the contact form on goodharbour.ca.' "$o/index.html" || fail "handoff explanation missing"
[ "$(grep -c 'href="mailto:' "$o/index.html")" = "2" ] || fail "homepage must keep two visible email paths"
[ "$(grep -c 'my independent software studio' "$o/index.html")" = "2" ] || fail "studio status must render in hero and contact"
grep -q 'founder of Goodharbour. Background, selected work' "$o/index.html" || fail "final profile description missing"
ruby -e 'links = File.read(ARGV.fetch(0)).scan(/<a\b[^>]*>/mi); abort "FAIL: homepage link forces a new browsing context" if links.any? { |link| link.match?(/\s+target\s*=/i) }' "$o/index.html"
grep -q 'href="https://ai.storeaudit.app/"' "$o/index.html" || fail "StoreAudit project link missing"
grep -q 'Explore StoreAudit' "$o/index.html" || fail "StoreAudit project CTA missing"
grep -q 'Explore FieldsRaven' "$o/index.html" || fail "FieldsRaven project CTA missing"
[ "$(grep -c '<blockquote class="text-gray-900 dark:text-gray-100">' "$o/index.html")" = "9" ] || fail "expected nine testimonial cards"
grep -q "src='/images/'" "$o/index.html" && fail "review with no portrait rendered a broken image" || true
ruby -e 'html = File.read(ARGV.fetch(0)); team = html[/<a\b[^>]*href="https:\/\/goodharbour\.ca\/contact\/\?type=team"[^>]*>(.*?)<\/a>/m, 1]; abort "FAIL: team CTA lacks Goodharbour destination cue" unless team&.include?("via Goodharbour")' "$o/index.html"
grep -q 'Working with Karim has been a great experience' "$o/index.html" || fail "Ivona review opening missing"
grep -q 'Would absolutely work with Karim again' "$o/index.html" || fail "Ivona review ending missing"
grep -q 'Monte Design · Review excerpt' "$o/index.html" && fail "Ivona review is still labeled as an excerpt" || true
# Enable with WI-20 (real icon files):
# [ -s "$o/favicon.ico" ] || fail "favicon.ico is empty"
# [ -f "$o/apple-touch-icon.png" ] || fail "apple-touch-icon.png missing"
ruby -rjson -e 'h=File.read("output/index.html"); j=h[/<script type="application\/ld\+json">(.*?)<\/script>/m,1] or abort("FAIL: no JSON-LD"); g=JSON.parse(j.gsub("<\\/","</")); types=g.fetch("@graph").map { |n| n["@type"] }; abort("FAIL: JSON-LD graph incomplete: #{types.inspect}") unless types.sort == ["Person", "ProfilePage", "WebSite"]'
echo "output checks passed"
