<%# Contact block. All values come from src/_data/content.yml; the K1 answer is a YAML edit. %>
<% cta = data.cta
   contact = data.contact
   mailto = "mailto:#{contact.email}?subject=#{contact.mailto_subject}" %>
<p class="text-base/7 font-semibold text-indigo-400"><%= contact.section_label %></p>
<h2 class="text-4xl font-semibold tracking-tight text-balance text-white sm:text-5xl"><%= contact.section_title %></h2>
<% if data.status_line %>
  <% before, after = data.status_line.split("Goodharbour", 2) %>
  <p class="mx-auto mt-6 max-w-xl text-lg/8 text-pretty text-gray-300"><%= before %><a href="https://goodharbour.ca/" class="font-semibold text-white underline decoration-indigo-400 underline-offset-4">Goodharbour</a><%= after %></p>
<% end %>
<% if contact.section_description %>
  <p class="mx-auto mt-4 max-w-xl text-base/7 text-gray-300"><%= contact.section_description %></p>
<% end %>

<% if cta.primary.type == "handoff" %>
  <div class="mx-auto mt-10 grid max-w-3xl gap-6 text-left sm:grid-cols-2">
    <% [cta.primary, cta.secondary].each do |item| %>
      <div class="flex h-full flex-col rounded-2xl bg-white/5 p-6 ring-1 ring-white/10">
        <% if item.heading %>
          <h3 class="text-base/7 font-semibold text-white"><%= item.heading %></h3>
        <% end %>
        <p class="mt-2 mb-6 text-sm/6 text-gray-300"><%= item.hint %></p>
        <a href="<%= item.url %>" class="mt-auto inline-flex flex-col self-start rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          <span><%= item.card_label || item.label %></span>
          <% if item.cue %><span class="text-xs font-normal text-indigo-100"><%= item.cue %></span><% end %>
        </a>
      </div>
    <% end %>
  </div>
  <p class="mt-4 text-sm/6 text-gray-400"><%= cta.handoff_note %></p>
  <p class="mt-10 text-base/7 text-gray-300">
    <%= contact.email_prompt %>
    <a id="contact-email" href="<%= mailto %>" class="font-semibold text-white underline decoration-indigo-400 underline-offset-4"><%= contact.email %></a>
    · <a href="<%= contact.linkedin_url %>" class="font-semibold text-white"><%= contact.linkedin_label %></a>
  </p>
<% else %>
  <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-x-6">
    <a id="contact-email" href="<%= mailto %>" class="inline-flex rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"><%= cta.primary.label %></a>
    <a href="<%= contact.linkedin_url %>" class="text-sm/6 font-semibold text-white"><%= contact.linkedin_label %> <span aria-hidden="true">→</span></a>
  </div>
  <p class="mt-6 text-base/7 text-gray-300"><a href="<%= mailto %>" class="font-semibold text-white underline decoration-indigo-400 underline-offset-4"><%= contact.email %></a></p>
  <% if cta.secondary && cta.secondary.type == "form_alternatives" %>
    <p class="mt-6 text-sm/6 text-gray-400">
      <%= cta.secondary.prompt %>
      <% cta.secondary.links.each_with_index do |link, index| %><%= " · " if index > 0 %><a href="<%= link.url %>" class="font-semibold text-white underline decoration-indigo-400 underline-offset-4"><%= link.label %></a><% end %>
    </p>
    <p class="mt-2 text-sm/6 text-gray-400"><%= cta.handoff_note %></p>
  <% end %>
<% end %>

<div class="mx-auto mt-10 max-w-2xl space-y-3 text-sm/6 text-gray-400">
  <p><%= contact.next_steps %></p>
  <p><%= contact.base_line %></p>
</div>
