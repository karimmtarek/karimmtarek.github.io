<!-- The mobile menu runs on the native invoker commands API (command/commandfor). -->
<!-- The script below shims it for browsers that predate it (Safari < 26.2, Firefox < 144, Chrome < 135), -->
<!-- so `@tailwindplus/elements` is not needed at runtime. -->
<% on_home = resource.data.layout == "home" %>
<% anchor_prefix = on_home ? "" : "/" %>
<header id="site-nav" data-solid="<%= on_home ? "false" : "true" %>" class="fixed inset-x-0 top-0 z-50 <%= on_home ? "bg-transparent" : "bg-gray-900 shadow-lg" %> transition-colors duration-300">
  <nav aria-label="Global" class="mx-auto flex max-w-7xl items-center justify-between p-6 lg:px-8">
    <a href="<%= anchor_prefix %>#header" class="-m-1.5 rounded-md p-1.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
      <img src='<%= relative_url "/images/karim-logo.svg" %>' alt="Karim Tarek" class="h-8 w-auto" />
    </a>
    <div class="flex items-center gap-x-4 lg:gap-x-10">
      <div class="hidden lg:flex lg:gap-x-10">
        <% data.nav.each do |link| %>
          <a href="<%= anchor_prefix %>#<%= link.href %>" class="text-sm/6 font-semibold text-white"><%= link.label %></a>
        <% end %>
      </div>
      <a href="<%= anchor_prefix %>#contact" class="rounded-md px-3 py-2 text-sm font-semibold text-white ring-1 ring-inset ring-white/40 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"><%= data.cta.header_label %></a>
      <div class="flex lg:hidden">
        <button type="button" command="show-modal" commandfor="mobile-menu" class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-white">
          <span class="sr-only">Open main menu</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6">
            <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>
  </nav>
  <el-dialog>
    <dialog id="mobile-menu" data-track-location="mobile-menu" aria-label="Main menu" class="backdrop:bg-transparent lg:hidden">
      <div tabindex="0" class="fixed inset-0 focus:outline-none">
        <el-dialog-panel class="fixed inset-y-0 right-0 z-50 w-full overflow-y-auto bg-gray-900 p-6 sm:max-w-sm sm:ring-1 sm:ring-gray-700">
          <div class="flex items-center justify-between">
            <a href="<%= anchor_prefix %>#header" class="-m-1.5 rounded-md p-1.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
              <img src='<%= relative_url "/images/karim-logo.svg" %>' alt="Karim Tarek" class="h-8 w-auto" />
            </a>
            <button type="button" command="close" commandfor="mobile-menu" class="-m-2.5 rounded-md p-2.5 text-white">
              <span class="sr-only">Close menu</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6">
                <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
          <div class="mt-6 flow-root">
            <div class="-my-6 divide-y divide-gray-700">
              <div class="space-y-2 py-6">
                <% data.nav.each do |link| %>
                  <a href="<%= anchor_prefix %>#<%= link.href %>" class="-mx-3 block rounded-lg px-3 py-2 text-base/7 font-semibold text-white hover:bg-gray-800"><%= link.label %></a>
                <% end %>
              </div>
              <div class="py-6">
                <a href="<%= anchor_prefix %>#contact" class="-mx-3 block rounded-lg px-3 py-2.5 text-center text-base/7 font-semibold text-white ring-1 ring-inset ring-white/40 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"><%= data.cta.header_label %></a>
              </div>
            </div>
          </div>
        </el-dialog-panel>
      </div>
    </dialog>
  </el-dialog>
</header>

<script>
  (function () {
    const nav = document.getElementById('site-nav');
    const mobileMenu = document.getElementById('mobile-menu');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Scroll-linked nav background
    const onScroll = () => {
      if (window.scrollY > 0) {
        nav.classList.add('bg-gray-900', 'shadow-lg');
        nav.classList.remove('bg-transparent');
      } else {
        nav.classList.remove('bg-gray-900', 'shadow-lg');
        nav.classList.add('bg-transparent');
      }
    };
    if (nav.dataset.solid !== 'true') window.addEventListener('scroll', onScroll, { passive: true });

    // Invoker commands shim. Safari only shipped command/commandfor in 26.2 (Firefox 144, Chrome 135), so on
    // older versions the hamburger would do nothing and there would be no mobile
    // navigation at all. Open and close the dialog by hand when it is missing.
    if (!('command' in HTMLButtonElement.prototype)) {
      document.querySelectorAll('button[commandfor]').forEach(button => {
        button.addEventListener('click', () => {
          const dialog = document.getElementById(button.getAttribute('commandfor'));
          if (!dialog) return;
          const command = button.getAttribute('command');
          if (command === 'show-modal') dialog.showModal();
          else if (command === 'close') dialog.close();
        });
      });
    }

    // Move focus to the section we scrolled to, so the keyboard tab order and the
    // screen reader cursor follow the page instead of staying on <body>.
    function focusTarget(el) {
      if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '-1');
      el.focus({ preventScroll: true });
    }

    // Custom fast smooth scroll (300ms, ease-out cubic), skipped entirely when the
    // visitor has asked for reduced motion.
    function smoothScrollTo(target, onDone, duration = 300) {
      const targetTop = target.getBoundingClientRect().top + window.scrollY - nav.offsetHeight;

      if (reduceMotion.matches) {
        window.scrollTo(0, targetTop);
        onDone();
        return;
      }

      const startY = window.scrollY;
      const diff = targetTop - startY;
      const startTime = performance.now();

      function step(now) {
        const progress = Math.min((now - startTime) / duration, 1);
        const ease = 1 - Math.pow(1 - progress, 3);
        window.scrollTo(0, startY + diff * ease);
        if (progress < 1) requestAnimationFrame(step);
        else onDone();
      }

      requestAnimationFrame(step);
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('a[href^="#"]').forEach(link => {
        const hash = link.getAttribute('href');
        if (!hash || hash.length < 2) return;

        const inMobileMenu = mobileMenu.contains(link);

        link.addEventListener('click', e => {
          const target = document.querySelector(hash);
          if (!target) return;
          e.preventDefault();
          smoothScrollTo(target, () => {
            // Close the panel before focusing: dialog.close() hands focus back to
            // the hamburger button, which would undo focusTarget otherwise.
            // This also replaces the old scrollend listener, which never fires on
            // Safari before 26.2.
            if (inMobileMenu && mobileMenu.open) mobileMenu.close();
            focusTarget(target);
          });
        });
      });
    });
  })();
</script>
