<div id="working-together" data-track-location="working-together" class="bg-white px-6 pt-12 pb-16 sm:pt-16 lg:px-8 dark:bg-gray-900">
  <div class="mx-auto max-w-3xl text-base/7 text-gray-700 dark:text-gray-300">
    <p class="text-base/7 font-semibold text-indigo-600 dark:text-indigo-400"><%= data.offer.section_label %></p>
    <h2 class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-5xl dark:text-white"><%= data.offer.section_title %></h2>
    <% data.offer.intro.each do |para| %>
      <p class="mt-6 text-xl/8"><%= para %></p>
    <% end %>
    <dl class="mt-10 grid max-w-2xl gap-8 sm:grid-cols-3">
      <% data.offer.ways.each do |way| %>
        <div>
          <dt class="font-semibold text-gray-900 dark:text-white"><%= way.title %></dt>
          <dd class="mt-2 text-sm/6 text-gray-600 dark:text-gray-400"><%= way.body %></dd>
        </div>
      <% end %>
    </dl>
    <% if data.offer.fit_line %>
      <p class="mt-8 text-sm/6 text-gray-600 dark:text-gray-400"><%= data.offer.fit_line %></p>
    <% end %>
    <div class="border-t border-gray-200 mt-10 sm:mt-16 dark:border-gray-700"></div>
  </div>
</div>
